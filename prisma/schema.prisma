// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id String @id @default(uuid())
  email String @unique @db.VarChar(30)
  password String?  @db.VarChar(30)
  profile Profile?
  googleSignOn Boolean @default(false)
  verified Boolean @default(false)
  calendarStatus Boolean @default(false)
  verificationToken String? @unique
  wishlists   Wishlist[]
  refreshTokens    RefreshToken[]
}

model Profile {
  id String @id @default(uuid())
  name String @db.VarChar(30)
  age Int
  gender String 
  location String @db.VarChar()
  userId  String @unique
  user    User @relation(fields: [userId], references: [id])
}

model Wishlist {
  id String @id @default(uuid())
  name String @db.VarChar(30)
  description String?
  shortId   String  @unique
  userId  String 
  user   User @relation(fields: [userId], references: [id])
  gifts Gift[]  @relation("wishlistToGift")
}

model Gift {
  id String @id @default(uuid())
  name  String  @db.VarChar(30)
  description String  @db.VarChar(255)
  price Decimal
  giftId  String // references the id of the gift from the external Api
  imageUrl String // references the image url of the gifts
  wishlistId  String
  tags  Tag[]  @relation("giftTags")
  wishlists Wishlist[] @relation("wishlistToGift")
  curatedLists  CuratedGift[] @relation("curatedGifts")
}

model CuratedGift {
  id String @id @default(uuid())
  title String @db.VarChar(30)
  description String @db.VarChar(255)
  gift Gift[] @relation("curatedGifts")
}

model Tag {
  id String @id @default(uuid())
  name String @db.VarChar(30)
  gifts Gift[] @relation("giftTags")
}

model RefreshToken {
  id            String      @id @default(uuid())
  userId String
  token         String      @unique
  createdAt     DateTime    @default(now())
  expiresAt     DateTime
  user          User @relation(fields: [userId], references: [id])
}