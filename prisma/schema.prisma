// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id String @id @default(uuid())
  name String?
  age Int?
  gender String?
  location String?
  email String @unique
  password String?
  googleSignOn Boolean @default(false)
  verified Boolean @default(false)
  activeStatus Boolean @default(false)
  calendarStatus Boolean @default(false)
  verificationToken String? @unique
  wishlists   Wishlist[]
  refreshTokens    RefreshToken[]
}

model Wishlist {
  id String @id @default(uuid())
  name String
  description String?
  shortId   String
  userId  String 
  user    User @relation(fields: [userId], references: [id])
  gifts Gift[]
}

model Gift {
  id String @id @default(uuid())
  description String
  giftUrl String // references the url of the gift(the external api url of the gift)
  purchased Boolean
  wishlistId  String
  wishlist Wishlist @relation(fields: [wishlistId], references: [id])
}

model RefreshToken {
  id            String      @id @default(uuid())
  userId String
  token         String      @unique
  createdAt     DateTime    @default(now())
  expiresAt     DateTime
  user          User @relation(fields: [userId], references: [id])
}