// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique @db.VarChar(255)
  firstName         String
  lastName          String
  password          String?        @db.VarChar(255)
  profile           Profile?
  googleSignOn      Boolean        @default(false)
  verified          Boolean        @default(false)
  verificationToken String?        @unique
  favourites        Favourites[]
  cart              Cart?
  sentGifts         Order[]        @relation("sentGifts")
  recievedGift      Order[]        @relation("recievedGifts")
  wishlists         Wishlist[]
  refreshTokens     RefreshToken[]
}

model Profile {
  id               String   @id @default(uuid())
  birthday         String
  purpose          String
  giftingOccasions String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  location         String   @db.VarChar(255)
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
}

model Wishlist {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(255)
  description String?
  shortId     String  @unique
  userId      String
  user        User    @relation(fields: [userId], references: [id])
  gifts       Gift[]
}

model Gift {
  id           String         @id @default(uuid())
  name         String         @db.VarChar(255)
  description  String         @db.VarChar(255)
  price        Decimal
  giftId       String 
  imageUrl     String
  tags         Tag[]
  cartGifts    CartGift[]
  wishlists    Wishlist[]
  favourites   Favourites[]   @relation("user_favourites")
  curatedgifts CuratedGifts[]
}

model Favourites {
  id     String @id @default(uuid())
  userId String
  giftId String
  gift   Gift   @relation("user_favourites", fields: [giftId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model Order {
  id                  String  @id @default(uuid())
  senderId            String
  shortId             String  @unique
  recieverId          String?
  recipientEmail      String
  personalisedMessage String? @db.Text()
  giftingPurpose      String  @db.VarChar(255)
  cartId              String  @unique
  isAnonymous         Boolean @default(false)
  cart                Cart    @relation(fields: [cartId], references: [id])
  sender              User    @relation(fields: [senderId], references: [id], name: "sentGifts")
  reciever            User?   @relation(fields: [recieverId], references: [id], name: "recievedGifts")
  isAccepted          Boolean @default(false)
  totalAmount         Decimal
}

enum PaymentStatus {
  PAID
  PENDING
  NOT_PAID
}

model Cart {
  id                    String        @id @default(uuid())
  createdAt             DateTime      @default(now())
  userId                String        @unique
  user                  User          @relation(fields: [userId], references: [id])
  paymentStatus         PaymentStatus @default(NOT_PAID)
  stripePaymentIntentId String?
  gifts                 CartGift[]
  Order                 Order?
}

model CartGift {
  id       String @id @default(uuid())
  giftId   String
  cartId   String
  quantity Int
  gift     Gift   @relation(fields: [giftId], references: [id])
  cart     Cart   @relation(fields: [cartId], references: [id])
}

model CuratedGifts {
  id          String @id @default(uuid())
  title       String @db.VarChar(255)
  description String @db.VarChar(255)
  gifts       Gift[]
}

model Tag {
  id    String @id @default(uuid())
  name  String @db.VarChar(255)
  gifts Gift[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}
