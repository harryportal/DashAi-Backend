// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique @db.VarChar(255)
  firstName         String
  lastName          String
  password          String?        @db.VarChar(255)
  profile           Profile?
  googleSignOn      Boolean        @default(false)
  verified          Boolean        @default(false)
  calendarStatus    Boolean        @default(false)
  verificationToken String?        @unique
  carts             Cart[]
  sentGifts         Order[]        @relation("sentGifts")
  recievedGift      Order[]        @relation("recievedGifts")
  wishlists         Wishlist[]
  refreshTokens     RefreshToken[]
}

model Profile {
  id               String   @id @default(uuid())
  birthday         String
  purpose          String
  giftingOccasions String[]
  location         String   @db.VarChar()
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
}

model Wishlist {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(255)
  description String?
  shortId     String  @unique
  userId      String
  user        User    @relation(fields: [userId], references: [id])
  gifts       Gift[]
}

model Gift {
  id           String         @id @default(uuid())
  name         String         @db.VarChar(255)
  description  String         @db.VarChar(255)
  price        Decimal
  giftId       String // references the id of the gift from the external Api
  imageUrl     String // references the image url of the gifts
  tags         Tag[]
  cartGifts    CartGift[]
  wishlists    Wishlist[]
  curatedgifts CuratedGifts[]
}

model Order {
  id                    String  @id @default(uuid())
  senderId              String
  recieverId            String?
  recipientEmail        String
  personalisedMessage   String? @db.Text()
  giftingPurpose        String  @db.VarChar(255)
  cartId                String  @unique
  isAnonymous           Boolean @default(false)
  cart                  Cart    @relation(fields: [cartId], references: [id])
  sender                User    @relation(fields: [senderId], references: [id], name: "sentGifts")
  reciever              User?   @relation(fields: [recieverId], references: [id], name: "recievedGifts")
  isAccepted            Boolean @default(false)
  totalAmount           Decimal
  stripePaymentIntentId String  @unique // has to be stored so the sender can be charged once gift is accepted
}

model Cart {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  user      User  @relation(fields: [userId], references: [id])
  gifts     CartGift[]  
  Order     Order? 
}

model CartGift {
  id       String @id @default(uuid())
  giftId   String
  cartId   String
  quantity Int
  gift     Gift   @relation(fields: [giftId], references: [id])
  cart     Cart   @relation(fields: [cartId], references: [id])
}

model CuratedGifts {
  id          String @id @default(uuid())
  title       String @db.VarChar(255)
  description String @db.VarChar(255)
  gifts       Gift[]
}

model Tag {
  id    String @id @default(uuid())
  name  String @db.VarChar(255)
  gifts Gift[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}
